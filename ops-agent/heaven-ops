#!/usr/bin/env python3
import json, subprocess, sys, urllib.request
ALLOWED = {'status','containers','player_api','recovery_logs','recovery_classes'}
def run(args, timeout=15):
 p=subprocess.run(args,capture_output=True,text=True,timeout=timeout,check=False); return {'exit_code':p.returncode,'stdout':p.stdout[-12000:],'stderr':p.stderr[-4000:]}
def main():
 if len(sys.argv)!=2 or sys.argv[1] not in ALLOWED: print(json.dumps({'error':'operation_not_allowed'})); return 2
 op=sys.argv[1]
 if op=='status': results={'containers':run(['/usr/bin/docker','ps','--format','{{.Names}} | {{.Image}} | {{.Status}}']),'disk':run(['/usr/bin/df','-h','/']),'memory':run(['/usr/bin/free','-h'])}
 elif op=='containers': results=run(['/usr/bin/docker','ps','-a','--format','{{.Names}} | {{.Image}} | {{.Status}} | {{.Ports}}'])
 elif op=='player_api':
  req=urllib.request.Request('https://play.heavenhotel.uk/api/community/status',headers={'User-Agent':'HeavenOps/1.0'})
  try:
   with urllib.request.urlopen(req,timeout=10) as response: results={'http_status':response.status,'body':response.read(4096).decode('utf-8','replace')}
  except Exception as e: results={'error':type(e).__name__+': '+str(e)[:300]}
 elif op=='recovery_logs':
  p=run(['/usr/bin/docker','logs','--since','24h','heaven-polaris-staging'],timeout=20); lines=(p.get('stdout','')+'\n'+p.get('stderr','')).splitlines(); terms=('auth/forgot-password','auth/reset-password','auth/verify-email','recovery email delivery failed','recovery queue is full','smtp','mail transport'); results={'matches':[line for line in lines if any(term in line.lower() for term in terms)][-40:],'note':'No matching log lines does not prove the flow works.'}
 elif op=='recovery_classes':
  jar='/home/heaven-deploy/heaven-staging/releases/polaris-40025074895/polaris.jar'; script='import zipfile,json; p='+repr(jar)+"; z=zipfile.ZipFile(p); terms=('PasswordResetEndpoints','SessionEndpoints','CommunityEndpoints','EmailVerificationEndpoints','SmtpMailService'); print(json.dumps([n for n in z.namelist() if any(t in n for t in terms)]))"; results=run(['/usr/bin/python3','-c',script])
 print(json.dumps(results,ensure_ascii=False)); return 0
if __name__=='__main__': sys.exit(main())